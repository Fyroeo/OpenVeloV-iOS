    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenVeloV uses your location to center the map, show how far you are from nearby Vélo'v stations, and — if you turn those options on — record your ride's route and tell you when you reach the station holding your bike."
